[{"start":27509.55,"end":27513.53,"text":"Okay. Yeah. It's Alessandro Olgiati from"},{"start":27513.59,"end":27514.11,"text":"Italy."},{"start":27514.69,"end":27515.13,"text":"Yeah. Thank you."},{"start":27515.33,"end":27515.67,"text":"Thank you."},{"start":27517.97,"end":27520.15,"text":"Thank you. Yeah. My name is Alessandro."},{"start":27521.55,"end":27523.25,"text":"I'm from Italy, from"},{"start":27524.91,"end":27527.45,"text":"CNR, National Research Council in Italy."},{"start":27528.39,"end":27528.63,"text":"And"},{"start":27529.57,"end":27532.19,"text":"I wanted to present... Thank you. Yeah"},{"start":27533.342,"end":27534.882,"text":"Here, I wanted to present"},{"start":27536.102,"end":27539.302,"text":"an example of how to"},{"start":27540.262,"end":27543.902,"text":"elevating a community observation into research"},{"start":27543.982,"end":27547.722,"text":"data. And our vision at the moment is,"},{"start":27549.722,"end":27552.662,"text":"rather than forcing a citizen to produce"},{"start":27553.362,"end":27554.282,"text":"structured data,"},{"start":27555.622,"end":27556.062,"text":"this one,"},{"start":27557.782,"end":27559.342,"text":"we build a workflow,"},{"start":27560.202,"end":27563.722,"text":"R package, to elevate this observation in"},{"start":27564.502,"end":27566.322,"text":"a community data structure"},{"start":27567.922,"end":27568.402,"text":"assigned."},{"start":27569.622,"end":27570.002,"text":"We use"},{"start":27571.322,"end":27573.362,"text":"iNaturalist as a base of"},{"start":27574.342,"end":27578.102,"text":"observation, and we are treating iNaturalist"},{"start":27578.462,"end":27582.062,"text":"as a service. And we have a"},{"start":27582.162,"end":27585.962,"text":"case study using ELTERA European"},{"start":27586.042,"end":27588.242,"text":"Research Infrastructure. And"},{"start":27590.082,"end":27593.602,"text":"if you don't know, this European infrastructure"},{"start":27594.122,"end":27597.702,"text":"is a distributed pan-European research infrastructure,"},{"start":27600.002,"end":27603.282,"text":"and the mission is to study long-term"},{"start":27603.882,"end":27604.002,"text":"and"},{"start":27604.062,"end":27608.862,"text":"multi-decadal"},{"start":27608.962,"end":27609.442,"text":"scale"},{"start":27610.522,"end":27613.822,"text":"ecological variation and parameter."},{"start":27615.102,"end":27615.422,"text":"And"},{"start":27616.642,"end":27617.062,"text":"already"},{"start":27618.122,"end":27618.542,"text":"mentioned,"},{"start":27620.242,"end":27621.662,"text":"we produce"},{"start":27623.182,"end":27623.842,"text":"R package,"},{"start":27624.742,"end":27625.622,"text":"the link is"},{"start":27626.522,"end":27629.742,"text":"there, that download the"},{"start":27630.062,"end":27630.942,"text":"observation from"},{"start":27632.382,"end":27633.002,"text":"iNaturalist"},{"start":27634.082,"end":27636.502,"text":"using the boundaries of ELTERA"},{"start":27637.462,"end":27638.422,"text":"RI site."},{"start":27640.002,"end":27642.222,"text":"We automated the semantic enrichment"},{"start":27642.602,"end":27646.042,"text":"using alternative"},{"start":27646.642,"end":27650.122,"text":"sources like UCN, EUNIS is in"},{"start":27650.482,"end":27654.122,"text":"database, and also the information necessary for"},{"start":27654.962,"end":27656.802,"text":"our infrastructure. And"},{"start":27658.122,"end":27661.782,"text":"the output is a research-ready"},{"start":27663.682,"end":27667.522,"text":"interactive map, analytical chart, and table."},{"start":27668.382,"end":27668.802,"text":"And"},{"start":27669.962,"end":27672.902,"text":"we have used four pillars for"},{"start":27673.622,"end":27676.942,"text":"enrich. One is about UCN"},{"start":27677.042,"end":27678.102,"text":"Red List,"},{"start":27679.162,"end":27679.662,"text":"the"},{"start":27681.142,"end":27684.802,"text":"EU Habitat and Bird Directive, and nativeness"},{"start":27685.522,"end":27689.042,"text":"using ESIN database and, again, standard"},{"start":27689.102,"end":27692.842,"text":"observation. And we obtain a table and a map"},{"start":27693.362,"end":27697.202,"text":"with this information of all the observation from"},{"start":27697.942,"end":27700.842,"text":"iNaturalist with all information mentioned"},{"start":27702.322,"end":27704.002,"text":"in these four pillars."},{"start":27705.482,"end":27708.882,"text":"What is the benefit? Is a dual benefit for"},{"start":27709.222,"end":27712.542,"text":"LTER-RI and for citizen science. For"},{"start":27712.682,"end":27716.622,"text":"ELTERA Research Infrastructure, research site,"},{"start":27717.702,"end":27718.742,"text":"we have a direct"},{"start":27719.682,"end":27720.722,"text":"contribution for"},{"start":27723.022,"end":27727.002,"text":"augmented the information and observation and"},{"start":27727.242,"end":27730.982,"text":"expanded spatial coverage of"},{"start":27731.042,"end":27731.262,"text":"this"},{"start":27732.122,"end":27734.102,"text":"observation. And from citizen,"},{"start":27734.982,"end":27735.942,"text":"we consider that"},{"start":27737.182,"end":27740.902,"text":"we have a co-design, enable a"},{"start":27740.942,"end":27744.002,"text":"volunteer to engage directly in campaign"},{"start":27744.782,"end":27748.442,"text":"and in future campaign for a European Research Infrastructure"},{"start":27748.942,"end":27751.242,"text":"and elevated scientific value"},{"start":27752.662,"end":27756.262,"text":"for observation. That's all for my time. Thank you."},{"start":27763.422,"end":27764.262,"text":"Any questions?"},{"start":27765.602,"end":27765.942,"text":"It's okay."},{"start":27767.102,"end":27768.522,"text":"Yeah. Any questions to"},{"start":27769.042,"end":27776.942,"text":"Alessandro?"},{"start":27777.022,"end":27777.942,"text":"Oh, not from... Okay."},{"start":27779.522,"end":27780.162,"text":"Thank you so much."}]