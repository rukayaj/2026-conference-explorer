[{"start":27460.564,"end":27461.584,"text":"Fantastic."},{"start":27461.864,"end":27462.124,"text":"Hello."},{"start":27463.044,"end":27464.744,"text":"I'm Christian from Estonia."},{"start":27466.024,"end":27466.884,"text":"And I'm"},{"start":27467.784,"end":27470.944,"text":"talking about digitizing some"},{"start":27472.024,"end":27475.624,"text":"very old historical or very long-lasted"},{"start":27476.804,"end":27478.604,"text":"data collection about"},{"start":27479.564,"end":27481.244,"text":"gulls, common gulls."},{"start":27482.384,"end":27486.204,"text":"Little introduction to where Estonia is and where"},{"start":27486.304,"end":27488.164,"text":"are the data gathered. It's"},{"start":27489.004,"end":27490.384,"text":"one small single"},{"start":27491.324,"end":27494.844,"text":"islet in western part of Estonia, and you saw"},{"start":27494.924,"end":27495.624,"text":"gulls there."},{"start":27496.784,"end":27497.044,"text":"So"},{"start":27498.284,"end":27501.844,"text":"the project started already in '60s, and"},{"start":27502.344,"end":27504.184,"text":"almost 60 years the"},{"start":27505.044,"end":27508.764,"text":"breeding data has been collected there, along with"},{"start":27509.344,"end":27512.744,"text":"several other experiments. But all the history"},{"start":27512.864,"end":27516.584,"text":"of the gulls breeding there has been"},{"start":27516.824,"end":27520.184,"text":"stored and is on this kind of"},{"start":27520.604,"end":27520.944,"text":"small"},{"start":27522.684,"end":27523.744,"text":"catalog cards."},{"start":27525.224,"end":27528.044,"text":"The methodology hasn't changed much"},{"start":27529.224,"end":27532.444,"text":"during this period, but that enables"},{"start":27532.524,"end":27536.124,"text":"to digitize the cards in a"},{"start":27536.464,"end":27537.644,"text":"similar manner."},{"start":27538.784,"end":27540.584,"text":"The cards consist of"},{"start":27542.364,"end":27545.984,"text":"distinct parts, header part with the card code,"},{"start":27546.744,"end":27550.184,"text":"some ringing data, and each year when the"},{"start":27550.664,"end":27553.444,"text":"individual bird was observed, the"},{"start":27554.204,"end":27556.844,"text":"data of its nest"},{"start":27557.864,"end":27561.724,"text":"was recorded and later stored on these cards."},{"start":27562.864,"end":27566.444,"text":"As you see, the cards also contain lots of handwritten"},{"start":27566.504,"end":27567.524,"text":"notes on"},{"start":27571.124,"end":27574.244,"text":"recoveries, if the bird was found elsewhere."},{"start":27575.324,"end":27575.604,"text":"So"},{"start":27577.004,"end":27580.124,"text":"the cards have been scanned, and"},{"start":27580.804,"end":27581.044,"text":"then"},{"start":27582.224,"end":27585.044,"text":"I developed a prompt to read them."},{"start":27586.324,"end":27590.244,"text":"That's a sample part of the prompt that describes the cards"},{"start":27590.304,"end":27592.184,"text":"that are quite similar."},{"start":27594.404,"end":27594.824,"text":"And"},{"start":27595.844,"end":27599.524,"text":"then we program the system to submit"},{"start":27600.204,"end":27604.024,"text":"the card images simultaneously to"},{"start":27604.104,"end":27606.004,"text":"several publicly available"},{"start":27607.104,"end":27607.624,"text":"LLMs."},{"start":27610.144,"end":27610.404,"text":"Then"},{"start":27611.384,"end":27613.664,"text":"after getting answers that were"},{"start":27614.764,"end":27616.104,"text":"in a testing phase,"},{"start":27618.164,"end":27619.404,"text":"the answers"},{"start":27620.464,"end":27620.744,"text":"were"},{"start":27621.604,"end":27625.084,"text":"presented in our application UI"},{"start":27625.244,"end":27625.604,"text":"as"},{"start":27626.684,"end":27627.304,"text":"if they were"},{"start":27629.684,"end":27630.844,"text":"similar by all"},{"start":27631.824,"end":27635.584,"text":"models. There was no differences."},{"start":27637.224,"end":27640.94,"text":"They were presented One character or number,"},{"start":27641.4,"end":27645,"text":"but if there were differences, a human reviewer had"},{"start":27645.08,"end":27645.4,"text":"to"},{"start":27646.88,"end":27647.98,"text":"decide which"},{"start":27650.08,"end":27653.6,"text":"is correct. So in this way, we tested and"},{"start":27655.66,"end":27657.9,"text":"obtained a ground truth"},{"start":27660.86,"end":27664.26,"text":"database, and then benchmarked"},{"start":27665.04,"end":27667.52,"text":"much more models on this ground truth"},{"start":27669.24,"end":27671.5,"text":"to find out which models"},{"start":27674.86,"end":27677.52,"text":"of these publicly available models are best for"},{"start":27680,"end":27683.52,"text":"making the big batch run. So the"},{"start":27683.56,"end":27687.24,"text":"results were that actually Gemini"},{"start":27687.42,"end":27689.78,"text":"models by Google were the best."},{"start":27692,"end":27692.48,"text":"And,"},{"start":27693.56,"end":27696.76,"text":"well, European Mistral was one of the"},{"start":27697.28,"end":27698.7,"text":"lowest, unfortunately."},{"start":27700.5,"end":27701.92,"text":"We just spent"},{"start":27702.88,"end":27703.88,"text":"about $50"},{"start":27704.9,"end":27707.26,"text":"for 3,000 decodings"},{"start":27708.58,"end":27709.78,"text":"for benchmarkings."},{"start":27713.64,"end":27716.34,"text":"The system also calculated"},{"start":27717.44,"end":27721.36,"text":"the effectiveness"},{"start":27721.48,"end":27725.42,"text":"of different models on different parts of the card."},{"start":27726.34,"end":27729.66,"text":"And, well, next is we can"},{"start":27730.66,"end":27732.02,"text":"analyze the data,"},{"start":27733.5,"end":27734.22,"text":"see the"},{"start":27736.6,"end":27740.34,"text":"confusion points that is also reported by the application,"},{"start":27740.6,"end":27744.44,"text":"and then run it on all about 9,000 cards."},{"start":27744.98,"end":27746.74,"text":"And then the data will be"},{"start":27747.92,"end":27751.58,"text":"stored in PlutoF database and"},{"start":27751.66,"end":27754.8,"text":"later published in GBIF."}]