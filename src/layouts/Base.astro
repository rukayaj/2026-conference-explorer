---
import "../styles/global.css";
import { href } from "../lib/site.js";
const navigation = [
  ["talks/", "Talks"],
  ["search/", "Search"],
  ["themes/", "Themes"],
  ["map/", "Map"],
  ["surprise/", "Surprise me"],
];
const activePath = Astro.url.pathname.slice(href("").length);
const isActive = (path) =>
  activePath.startsWith(path) ||
  (path === "talks/" && activePath.startsWith("talk/")) ||
  (path === "themes/" && activePath.startsWith("theme/"));
const {
  title = "TDWG 2026 · Explore the conversation",
  description = "Explore talks, themes and moments from TDWG 2026.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071e20" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={href("favicon.png")} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={href("")} aria-label="TDWG 2026 home">
          <img
            class="brand-mark"
            src={href("brand/troll.png")}
            alt=""
            width="44"
            height="44"
          />
          <span>
            TDWG<span class="brand-year">2026</span>
          </span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          {navigation.map(([path, label]) => (
            <a
              href={href(path)}
              class:list={{ "nav-surprise": path === "surprise/" }}
              aria-current={isActive(path) ? "page" : undefined}
            >
              {label}
              {path === "surprise/" && <span aria-hidden="true">↗</span>}
            </a>
          ))}
        </nav>
      </header>
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="footer-brand">
          <img
            src={href("brand/tdwg-2026-badge.png")}
            alt="TDWG 2026 Oslo, Norway logo featuring the troll mascot Gymimir Standardsen"
            width="96"
            height="96"
            loading="lazy"
          />
          <div>
            <strong>TDWG 2026, revisited.</strong>
            <p>
              A playful guide to the conference, built from recordings and
              machine-produced transcripts. Check the video when precision
              matters.
            </p>
          </div>
        </div>
        <div class="footer-links">
          <a href={href("talks/")}>All talks & discussions</a>
          <a href={href("search/")}>Find a moment</a>
          <a href={href("themes/")}>Browse themes</a>
          <a href={href("map/")}>Explore the map</a>
        </div>
      </footer>
    </div>
  </body>
</html>
