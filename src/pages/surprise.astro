---
import Base from '../layouts/Base.astro';
import { href } from '../lib/site.js';
---
<Base title="Surprise me · TDWG 2026">
  <section class="surprise-hero"><div class="container"><div class="eyebrow">A little serendipity</div><h1 class="display">Take the scenic route.</h1><p>Skip the programme. Find a moment, follow a connection, or hop into another corner of the conference.</p></div><div class="spark spark-one">✳</div><div class="spark spark-two">✦</div></section>
  <section class="container surprise-content" id="surprise-app" data-base={href('')}>
    <div class="mode-buttons"><button data-mode="moment" class="active">✦ A good moment</button><button data-mode="connection">↝ A cross-session connection</button><button data-mode="rabbit">✳ Follow a rabbit hole</button></div>
    <div id="surprise-result" class="surprise-result"><div class="empty-state">Finding somewhere interesting to start…</div></div>
    <button id="again" class="button button-dark">Show me another ↗</button>
  </section>
</Base>

<script>
  const app = document.querySelector('#surprise-app'); const base = app.dataset.base;
  const destination = document.querySelector('#surprise-result'); const again = document.querySelector('#again');
  const buttons = [...document.querySelectorAll('[data-mode]')];
  const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]);
  const timeLabel = (value) => { const s = Math.floor(value), h = Math.floor(s / 3600), m = Math.floor(s % 3600 / 60); return `${h}:${String(m).padStart(2,'0')}:${String(s % 60).padStart(2,'0')}`; };
  const stampSeconds = (value) => { const [h,m,s] = String(value).split(':').map(Number); return h * 3600 + m * 60 + s; };
  let items, themes, related, connections, featuredMoments, mode = 'moment', currentId;
  let recent = [];
  try { recent = JSON.parse(localStorage.getItem('tdwg-recent-surprises') || '[]'); } catch {}
  function choose(candidates, key) {
    const fresh = candidates.filter((entry) => !recent.includes(key(entry)));
    const pool = fresh.length ? fresh : candidates;
    const selected = pool[Math.floor(Math.random() * pool.length)];
    if (selected) { recent = [key(selected), ...recent].slice(0, 20); try { localStorage.setItem('tdwg-recent-surprises', JSON.stringify(recent)); } catch {} }
    return selected;
  }
  function renderMoment() {
    const candidates = featuredMoments.map((moment) => ({ item: items.get(moment.itemId), moment })).filter((entry) => entry.item);
    const pick = choose(candidates, ({ item, moment }) => `${item.id}:${moment.timestamp}`);
    if (!pick) return;
    currentId = pick.item.id; const seconds = stampSeconds(pick.moment.timestamp);
    destination.innerHTML = `<div class="feature-card"><div class="feature-kicker">✦ A moment worth watching · ${escapeHtml(pick.item.room)}</div><h2>${escapeHtml(pick.moment.description)}</h2><p>From <strong>${escapeHtml(pick.item.title)}</strong> with ${escapeHtml(pick.item.speakers.slice(0, 2).join(', ') || 'the discussion')}.</p><div class="feature-actions"><a class="button" href="${base}talk/${encodeURIComponent(pick.item.id)}/?t=${seconds}#video">▶ Watch from ${timeLabel(seconds)}</a><a class="text-link" href="${base}talk/${encodeURIComponent(pick.item.id)}/">Explore the talk ↗</a></div></div>`;
  }
  function renderConnection() {
    const pick = choose(connections, ({ a, b }) => `${a}:${b}`);
    if (!pick) { renderMoment(); return; }
    const first = items.get(pick.a), second = items.get(pick.b), theme = themes.get(pick.theme);
    currentId = second.id;
    destination.innerHTML = `<div class="connection-heading"><div class="feature-kicker">↝ A connection across the conference</div><h2>Two talks, one thread.</h2><p>Both are connected to <a href="${base}theme/${encodeURIComponent(theme.id)}/">${escapeHtml(theme.name)}</a>, from different sessions.</p></div><div class="connection-grid"><a href="${base}talk/${encodeURIComponent(first.id)}/" class="connection-card"><img class="still" src="${base}stills/${encodeURIComponent(first.id)}.webp" alt="" width="640" height="360"><span>${escapeHtml(first.room)} · ${escapeHtml(first.day)}</span><h3>${escapeHtml(first.title)}</h3><p>${escapeHtml(first.takeaway)}</p><strong>Explore talk ↗</strong></a><div class="connection-symbol">↝</div><a href="${base}talk/${encodeURIComponent(second.id)}/" class="connection-card"><img class="still" src="${base}stills/${encodeURIComponent(second.id)}.webp" alt="" width="640" height="360"><span>${escapeHtml(second.room)} · ${escapeHtml(second.day)}</span><h3>${escapeHtml(second.title)}</h3><p>${escapeHtml(second.takeaway)}</p><strong>Explore talk ↗</strong></a></div>`;
  }
  function renderRabbit() {
    const starting = currentId ? items.get(currentId) : choose([...items.values()], (item) => item.id);
    const sharesTheme = (item) => item.themes.some((id) => starting.themes.includes(id));
    const candidates = (related[starting.id] || []).map((id) => items.get(id)).filter((item) => item && item.session !== starting.session && sharesTheme(item));
    const sameThread = [...items.values()].filter((item) => item.id !== starting.id && item.session !== starting.session && sharesTheme(item));
    const next = choose(candidates.length ? candidates : sameThread.length ? sameThread : [...items.values()].filter((item) => item.id !== starting.id), (item) => item.id);
    if (!next) return;
    currentId = next.id;
    const shared = starting.themes.find((id) => next.themes.includes(id));
    destination.innerHTML = `<div class="feature-card"><div class="feature-kicker">✳ One idea leads to another</div><h2>${escapeHtml(next.title)}</h2><p>${escapeHtml(next.takeaway || next.summary)}</p>${shared ? `<p class="thread-note">Your thread: <a href="${base}theme/${encodeURIComponent(shared)}/">${escapeHtml(themes.get(shared)?.name || 'shared theme')} ↗</a></p>` : ''}<div class="feature-actions"><a class="button" href="${base}talk/${encodeURIComponent(next.id)}/">Follow this talk ↗</a><span>From “${escapeHtml(starting.title)}”</span></div></div>`;
  }
  function render() { if (!items) return; if (mode === 'moment') renderMoment(); else if (mode === 'connection') renderConnection(); else renderRabbit(); }
  buttons.forEach((button) => button.addEventListener('click', () => { mode = button.dataset.mode; buttons.forEach((entry) => entry.classList.toggle('active', entry === button)); render(); }));
  again.addEventListener('click', render);
  Promise.all(['items.json', 'themes.json', 'related.json', 'connections.json', 'featured-moments.json'].map((name) => fetch(`${base}data/${name}`).then((response) => response.json()))).then(([itemData, themeData, relatedData, connectionData, momentData]) => {
    items = new Map(itemData.map((item) => [item.id, item])); themes = new Map(themeData.map((theme) => [theme.id, theme])); related = relatedData; connections = connectionData; featuredMoments = momentData; render();
  }).catch(() => { destination.innerHTML = '<div class="empty-state">The discovery cards could not be loaded right now.</div>'; });
</script>

<style is:global>
.surprise-hero{background:#dbe9ac;padding:76px 0 90px;position:relative;overflow:hidden}.surprise-hero h1{font-size:clamp(3.5rem,7vw,6.5rem);max-width:850px;margin:15px 0}.surprise-hero p{max-width:610px;line-height:1.6;font-size:1.1rem;color:#4e7060}.spark{position:absolute;color:#93b86c;pointer-events:none}.spark-one{font-size:18rem;right:6%;top:-35px}.spark-two{font-size:7rem;right:24%;bottom:-40px}.surprise-content{padding-top:50px;text-align:center;min-height:430px}.mode-buttons{display:flex;justify-content:center;flex-wrap:wrap;gap:9px;margin-bottom:34px}.mode-buttons button{border:1px solid #b9d0bb;border-radius:100px;padding:11px 16px;background:transparent;color:#41695e;font-weight:750;font-size:.82rem}.mode-buttons button.active,.mode-buttons button:hover{background:#153b3c;color:#fff;border-color:#153b3c}.surprise-result{text-align:left;max-width:920px;margin:auto}.feature-card{background:#fff;border:1px solid #dbe5d8;border-radius:18px;padding:clamp(25px,5vw,55px);min-height:280px}.feature-kicker{text-transform:uppercase;letter-spacing:.12em;font-size:.72rem;font-weight:850;color:#598b67}.feature-card h2,.connection-heading h2{font:400 clamp(2rem,4vw,3.4rem)/1.1 Georgia,serif;letter-spacing:-.045em;margin:17px 0}.feature-card>p{line-height:1.65;color:#56786e;max-width:730px}.feature-actions{display:flex;align-items:center;flex-wrap:wrap;gap:20px;margin-top:30px}.feature-actions span{color:#789286;font-size:.76rem}.thread-note{font-size:.86rem}.thread-note a{text-decoration:underline}.connection-heading{text-align:center;margin-bottom:26px}.connection-heading p{color:#617d70}.connection-heading a{text-decoration:underline}.connection-grid{display:grid;grid-template-columns:1fr 40px 1fr;align-items:center;gap:10px}.connection-card{background:#fff;border:1px solid #dce5d7;border-radius:16px;padding:25px;min-height:270px;overflow:hidden}.connection-card .still{width:calc(100% + 50px);max-width:none;margin:-25px -25px 18px}.connection-card:hover{border-color:#8fb88d}.connection-card span{font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;font-weight:850;color:#709783}.connection-card h3{font:400 1.5rem/1.2 Georgia,serif;margin:13px 0}.connection-card p{font-size:.84rem;line-height:1.5;color:#658079}.connection-card strong{font-size:.78rem;color:#36745f}.connection-symbol{font:400 2rem Georgia,serif;text-align:center;color:#82a773}#again{margin-top:25px}@media(max-width:650px){.spark-one{right:-90px;opacity:.35}.connection-grid{grid-template-columns:1fr}.connection-symbol{transform:rotate(90deg)}}
</style>
