---
import Base from '../layouts/Base.astro';
import { href, stillSrc } from '../lib/site.js';
import items from '../../public/data/items.json';
import themes from '../../public/data/themes.json';

const featuredIds = ['ai-ready-data', 'persistent-identifiers', 'specimen-digitisation', 'data-provenance', 'knowledge-graphs', 'data-quality'];
const featuredThemes = featuredIds.map((id) => themes.find((theme) => theme.id === id)).filter(Boolean);
const featuredTalks = ['ai-ready-data', 'specimen-digitisation', 'data-provenance'].map((id) => items.find((item) => item.themes.includes(id))).filter((item, index, array) => array.findIndex((other) => other.id === item.id) === index);
---
<Base>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <div class="eyebrow hero-eyebrow">The conversations behind the conference</div>
        <h1 class="display">What happened<br />at <em>TDWG 2026?</em></h1>
        <p>Find the moments, ideas and unexpected connections in hundreds of talks and discussions. Start with a question and follow your curiosity.</p>
        <form class="search-box" action={href('search/')} method="get">
          <input name="q" aria-label="Search the conference" placeholder="What did TDWG say about AI-ready data?" required />
          <button type="submit">Explore <span aria-hidden="true">↗</span></button>
        </form>
        <div class="suggestions"><span>Try:</span><a href={href('search/?q=Darwin%20Core')}>Darwin Core</a><a href={href('search/?q=AI%20readiness')}>AI readiness</a><a href={href('search/?q=specimen%20digitisation')}>digitisation</a></div>
      </div>
      <div class="hero-orbit" aria-hidden="true"><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><span class="orbit orbit-three"></span><img class="orbit-center" src={href('brand/tdwg-2026-badge.png')} alt="" width="190" height="190" /><span class="orbit-dot dot-one"></span><span class="orbit-dot dot-two"></span><span class="orbit-dot dot-three"></span><span class="orbit-dot dot-four"></span></div>
    </div>
    <div class="hero-stats container"><span><strong>{items.length}</strong> talks & discussions</span><span><strong>{themes.length}</strong> connected themes</span><span><strong>1</strong> conference to explore</span></div>
  </section>

  <section class="container home-section" id="paths">
    <div class="section-heading"><div><div class="eyebrow">Choose a path</div><h2>Go wherever curiosity leads.</h2></div></div>
    <div class="path-grid">
      <a class="path-card path-search" href={href('search/')}><span class="path-icon">⌕</span><span class="path-kicker">01 / Find a moment</span><h3>Ask the conference.</h3><p>Search the actual transcript and jump straight to the relevant video.</p><span class="path-arrow">↗</span></a>
      <a class="path-card path-map" href={href('map/')}><span class="path-icon">✳</span><span class="path-kicker">02 / See the big picture</span><h3>Explore the map.</h3><p>Wander through talks by idea, across rooms and sessions.</p><span class="path-arrow">↗</span></a>
      <a class="path-card path-surprise" href={href('surprise/')}><span class="path-icon">✦</span><span class="path-kicker">03 / Take a chance</span><h3>Surprise me.</h3><p>Find a great moment or a connection you might have missed.</p><span class="path-arrow">↗</span></a>
    </div>
  </section>

  <section class="container home-section">
    <div class="section-heading"><div><div class="eyebrow">Ideas that travelled</div><h2>Explore by theme.</h2></div><a class="text-link" href={href('themes/')}>All {themes.length} themes ↗</a></div>
    <div class="card-grid">{featuredThemes.map((theme) => <a class="card theme-card" href={href(`theme/${theme.id}/`)}><span class="small-meta">{theme.content_item_count} connected items</span><h3>{theme.name}</h3><p>{theme.description}</p></a>)}</div>
  </section>

  <section class="container home-section featured-section">
    <div class="section-heading"><div><div class="eyebrow">A few starting points</div><h2>Pick a talk and dive in.</h2></div><a class="text-link" href={href('search/')}>Explore all talks ↗</a></div>
    <div class="card-grid">{featuredTalks.map((item) => <a class="card talk-card" href={href(`talk/${item.id}/`)}><img class="still" src={stillSrc(item.id)} alt="" width="640" height="360" loading="lazy" /><span class="small-meta">{item.type} · {item.room}</span><h3>{item.title}</h3><p>{item.takeaway}</p><div class="card-bottom"><span>{item.speakers.slice(0,2).join(', ') || 'Conference discussion'}</span><span class="link-arrow">↗</span></div></a>)}</div>
  </section>
</Base>

<style>
.hero{background:#0b3031;color:#eff7e8;position:relative;overflow:hidden}.hero-inner{min-height:625px;display:flex;align-items:center;position:relative;padding-top:65px;padding-bottom:80px}.hero-copy{position:relative;z-index:2;width:min(760px,70%)}.hero-eyebrow{color:#cbe684}.hero h1{font-size:clamp(4rem,7.5vw,7.2rem);margin:18px 0 24px}.hero h1 em{color:#cce77e;font-weight:400}.hero-copy>p{color:#bdd4c8;font-size:1.17rem;line-height:1.6;max-width:590px;margin-bottom:32px}.suggestions{display:flex;flex-wrap:wrap;align-items:center;gap:12px;font-size:.82rem;color:#91b2a5;margin-top:20px}.suggestions a{color:#d7eeae;border-bottom:1px solid #688d6d}.hero-orbit{position:absolute;width:575px;height:575px;right:-65px;top:35px;opacity:.86}.orbit{position:absolute;border:1px solid rgba(175,223,180,.25);border-radius:50%;inset:0}.orbit-two{inset:75px}.orbit-three{inset:150px}.orbit-center{position:absolute;left:50%;top:50%;width:190px;height:190px;transform:translate(-50%,-50%);border-radius:50%;box-shadow:0 0 0 14px rgba(204,231,126,.08),0 20px 60px rgba(0,0,0,.35)}.orbit-dot{position:absolute;border-radius:50%;background:#cce77e;box-shadow:0 0 32px #cce77e75}.dot-one{width:16px;height:16px;top:75px;left:120px}.dot-two{width:31px;height:31px;top:165px;right:29px;background:#87c7b1}.dot-three{width:20px;height:20px;bottom:40px;left:155px}.dot-four{width:9px;height:9px;top:265px;left:75px}.hero-stats{border-top:1px solid #3e5c52;display:flex;gap:58px;padding-top:20px;padding-bottom:23px;color:#a3c1b3;font-size:.9rem}.hero-stats strong{color:#d3ee96;font-size:1.25rem;margin-right:7px}.home-section{padding-top:90px}.path-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.path-card{min-height:315px;border-radius:19px;position:relative;overflow:hidden;padding:25px;display:flex;flex-direction:column;align-items:flex-start;transition:transform .2s}.path-card:hover{transform:translateY(-4px)}.path-search{background:#dce9d4}.path-map{background:#cce1d4}.path-surprise{background:#dfe7ad}.path-icon{font:400 3rem Georgia,serif;line-height:1;margin-bottom:auto}.path-kicker{font-size:.72rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase;margin-top:30px}.path-card h3{font:400 2.3rem/1 Georgia,serif;letter-spacing:-.05em;margin:10px 0}.path-card p{line-height:1.45;color:#416962;max-width:280px;margin:0}.path-arrow{position:absolute;right:23px;top:23px;font-size:1.4rem}.featured-section{padding-bottom:20px}@media(max-width:900px){.hero-copy{width:85%}.hero-orbit{right:-260px;opacity:.45}.path-grid{grid-template-columns:1fr 1fr}.path-card:last-child{grid-column:1/-1;min-height:220px}}@media(max-width:600px){.hero-inner{min-height:600px;padding-top:60px}.hero-copy{width:100%}.hero h1{font-size:3.7rem}.hero-orbit{right:-360px}.hero-stats{gap:17px;flex-wrap:wrap}.path-grid{grid-template-columns:1fr}.path-card:last-child{grid-column:auto;min-height:315px}.home-section{padding-top:65px}}
</style>
